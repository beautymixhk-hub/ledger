# ---- Server ----
PORT=4000
NODE_ENV=development
APP_URL=http://localhost:5173
API_URL=http://localhost:4000

# ---- Database ----
# Local: postgres://postgres:postgres@localhost:5432/ledger
# Managed (Neon/Supabase/RDS): paste the connection string they give you
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ledger

# ---- Auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_string
JWT_EXPIRES_IN=7d

# ---- Anthropic (Claude) ----
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
CLAUDE_MODEL=claude-sonnet-4-6

# ---- OpenAI (alternative AI provider) ----
# Each org picks "claude" or "openai" in Settings; you only need to fill in the
# key(s) for whichever provider(s) your orgs actually use.
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-5.4

# ---- Email sending (Resend) ----
# Sign up at resend.com, verify your sending domain (SPF + DKIM + DMARC)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
MAIL_FROM_NAME=Your Name
MAIL_FROM_EMAIL=you@yourverifieddomain.com
# Resend posts delivery/open/click/bounce events here. Set this URL in the Resend dashboard.
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# ---- Sending safety limits ----
# Hard caps so a bad config can't blast thousands of emails.
MAX_EMAILS_PER_CAMPAIGN=200
MAX_EMAILS_PER_DAY_PER_ORG=500
SEND_DELAY_MS=1200
